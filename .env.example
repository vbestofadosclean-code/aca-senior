# PostgreSQL connection string supplied by your hosting/database provider
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Long random secret used to sign the administrator session cookie
JWT_SECRET=replace-with-a-long-random-secret
# Administrator credentials: keep these ONLY in the hosting/server environment.
ADMIN_EMAIL=your-main-admin-email@example.com
ADMIN_EMAIL_ALT=your-alternative-admin-email@example.com
ADMIN_PASSWORD_1=replace-with-strong-password-1
ADMIN_PASSWORD_2=replace-with-strong-password-2
NODE_ENV=production
